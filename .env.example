# Server-side Supabase connection only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional server-side CoinGecko API key. Demo is the default plan.
# Never prefix provider keys with NEXT_PUBLIC_.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo

# DeFiLlama public API has no key, but syncing is disabled unless written
# permission covers this project's storage/use. Store a non-secret agreement
# or approval reference here only after permission is granted.
DEFILLAMA_WRITTEN_PERMISSION_REFERENCE=

# Protects the scheduled refresh endpoint (/api/cron/refresh). Vercel Cron sends
# it as "Authorization: Bearer <value>". Use a random string of 16+ characters.
# Server-side only; never prefix with NEXT_PUBLIC_.
CRON_SECRET=

# Deep AI Analysis (Gemini). Server-side only; never prefix with NEXT_PUBLIC_.
# Without GEMINI_API_KEY the Token Profile shows "AI analysis unavailable".
GEMINI_API_KEY=
# Optional model override (defaults to gemini-3.6-flash).
GEMINI_MODEL=

# Deep AI Analysis fallback (OpenRouter), used only when Gemini is temporarily
# unavailable (429/5xx/timeout). Server-side only; never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
