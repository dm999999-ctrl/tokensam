# Server-side Supabase connection only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional server-side CoinGecko API key. Demo is the default plan.
# Never prefix provider keys with NEXT_PUBLIC_.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo
# Optional: route CoinGecko requests through the Cloudflare Worker's /coingecko-proxy
# route (cloudflare/refresh-scheduler/) instead of calling CoinGecko directly from this
# deployment. Use this if CoinGecko starts rejecting requests from this platform's IP
# range specifically (confirm by testing the same key directly from outside this platform
# first) — Cloudflare's outbound IPs are a separate pool. Set to the Worker's base URL,
# e.g. "https://token-samurai-refresh-scheduler.<subdomain>.workers.dev" (no trailing
# slash, no path). Requires CRON_SECRET to also be set, and the Worker's own
# COINGECKO_API_KEY secret (see wrangler.toml) to hold a valid key — that copy is
# independent of this one and is what actually gets used once this var is set.
COINGECKO_PROXY_URL=

# DeFiLlama public API has no key, but syncing is disabled unless written
# permission covers this project's storage/use. Store a non-secret agreement
# or approval reference here only after permission is granted.
DEFILLAMA_WRITTEN_PERMISSION_REFERENCE=

# Protects the scheduled refresh endpoints (/api/cron/refresh and
# /api/cron/geckoterminal). Vercel Cron sends it as "Authorization: Bearer <value>".
# Use a random string of 16+ characters. Server-side only; never prefix with NEXT_PUBLIC_.
CRON_SECRET=

# GeckoTerminal is a keyless public API (no API key needed), but scheduled
# collection is disabled by default so deploying this route never silently
# starts spending its rate limit. See docs/geckoterminal-integration.md.
# Set to "true" to enable /api/cron/geckoterminal (still requires CRON_SECRET).
GECKOTERMINAL_SYNC_ENABLED=
# Minimum time between successful runs, in milliseconds. Default: 86400000 (24h).
GECKOTERMINAL_SYNC_INTERVAL=
# Optional extra pacing between GeckoTerminal requests, in milliseconds. May only
# raise the collector's built-in minimum (6500ms); it can never lower it.
GECKOTERMINAL_BATCH_DELAY_MS=

# ---- Deep AI Analysis provider router (Phase 2). All server-side; never NEXT_PUBLIC_. ----
# Providers are tried in this order; only configured, allowed, capable providers
# that are not cooling down are called. Without any configured provider the
# Token Profile shows "AI analysis unavailable".
AI_PROVIDER_PRIORITY=qwen,hunyuan,glm,mistral,groq,siliconflow,gemini,openrouter
# Free-access classes that may be called: FREE (default). Add FREE_TRIAL to use
# promotional quotas (Qwen new-user quota, Hunyuan TokenHub credits). Paid is never allowed.
AI_ALLOWED_FREE_TIERS=FREE

# Qwen (Alibaba Cloud Model Studio, Singapore/International). Enable the console's
# "Free quota only" setting so an exhausted quota fails instead of billing.
DASHSCOPE_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=
# Hunyuan (Tencent Cloud TokenHub, international endpoint).
HUNYUAN_API_KEY=
HUNYUAN_MODEL=
# GLM (Z.AI). Registered, but JSON Schema output is not documented (JSON mode only).
ZHIPU_API_KEY=
# Mistral (Free mode; keep pay-as-you-go disabled).
MISTRAL_API_KEY=
MISTRAL_MODEL=
# Groq (Free plan). Its 8K tokens/minute free cap is below the research prompt size.
GROQ_API_KEY=
# SiliconFlow (free models). Set a model only after verifying it supports JSON Schema.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=

# Gemini (backup). Optional model override (defaults to gemini-3.6-flash).
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter (backup). Only ":free" models or openrouter/free are ever called.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
